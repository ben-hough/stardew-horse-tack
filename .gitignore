# build output
bin/
obj/
*.user
.vs/
*.zip

# game / SMAPI reference assemblies - never commit
refs/
*.dll
*.pdb
*.xnb

# third-party art and previews derived from it - never commit
poc/
previews/
elle/
**/Elle*/
# HorseTack's own generated art in assets/ IS committed (original, see tools/art).
# Never commit anyone else's art: Elle's Cuter Horses stays in her own mod folder.
__pycache__/
*.pyc
tests/**/data/

# secrets
.env
*.token
secrets.*
